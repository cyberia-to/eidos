-- 7 = 2*3+1, with the separate requirement 1<3.
def one : BNat := BNat.positive Pos.one
def two : BNat := BNat.positive (Pos.bit0 Pos.one)
def three : BNat := BNat.positive (Pos.bit1 Pos.one)
def seven : BNat := BNat.positive (Pos.bit1 (Pos.bit1 Pos.one))
theorem reconstruction : Eq BNat (BNat.add (BNat.mul two three) one) seven := by { rfl }
theorem range : Eq Bool (BNat.lt one three) Bool.true := by { rfl }
